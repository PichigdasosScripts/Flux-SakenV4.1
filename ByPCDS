local function GetBestHeavyRoot()
    if not LocalRoot then return nil end
    local Camera = workspace.CurrentCamera
    local Best, BestScore = nil, math.huge
    for _, Player in Players:GetPlayers() do
        if Player ~= LocalPlayer and Player.Character then
            local Humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            if Humanoid and Root and Humanoid.Health > 0 and Humanoid.MaxHealth > 500 then
                local Distance = (LocalRoot.Position - Root.Position).Magnitude
                local Score = Distance
                if Camera then
                    local _, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                    if OnScreen then
                        local Dir = (Root.Position - Camera.CFrame.Position).Unit
                        Score = Distance * (1.6 - Camera.CFrame.LookVector:Dot(Dir))
                    end
                end
                if Distance < 40 and Score < BestScore then Best = Root; BestScore = Score end
            end
        end
    end
    return Best
end

local AimVelocity = Vector3.zero
local PunchLeadTime = 0.12

local function StartAiming()
    StopAiming()
    AimVelocity = Vector3.zero
    AimConnection = RunService.Heartbeat:Connect(function(Delta)
        if not State.PunchAimbot or not LocalRoot then return end
        local Target = GetBestHeavyRoot()
        if not Target then return end
        local Predicted = Target.Position + Target.AssemblyLinearVelocity * PunchLeadTime
        local ToTarget = Vector3.new(Predicted.X - LocalRoot.Position.X, 0, Predicted.Z - LocalRoot.Position.Z)
        if ToTarget.Magnitude < 0.01 then return end
        local Wanted = ToTarget.Unit
        local Blend = math.clamp(Delta * 18, 0, 1)
        local Current = LocalRoot.CFrame.LookVector
        local Smoothed = Vector3.new(Current.X, 0, Current.Z):Lerp(Wanted, Blend)
        if Smoothed.Magnitude < 0.01 then Smoothed = Wanted end
        LocalRoot.CFrame = CFrame.new(LocalRoot.Position, LocalRoot.Position + Smoothed.Unit)
        local Camera = workspace.CurrentCamera
        if Camera then
            local Aim = CFrame.new(Camera.CFrame.Position, Predicted)
            Camera.CFrame = Camera.CFrame:Lerp(Aim, math.clamp(Delta * 25, 0, 1))
        end
    end)
end

