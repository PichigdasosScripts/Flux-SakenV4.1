do
    local ChanceMotion = setmetatable({}, { __mode = "k" })
    local ChanceAimingUntil = 0
    local ChanceHolding = false
    local ChanceGyro
    local ChancePingVal, ChancePingTime = 0.1, 0
    local ChanceTriggers = {
        ["133607163653602"] = true, ["133491532453922"] = true, ["131189930305001"] = true,
        ["111384272984267"] = true, ["103601716322988"] = true, ["76649505662612"] = true
    }

    local function ChanceGetPing()
        local Now = os.clock()
        if Now - ChancePingTime < 1 then return ChancePingVal end
        ChancePingTime = Now
        local Ok, Stat = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        ChancePingVal = (Ok and Stat or 100) / 1000
        return ChancePingVal
    end

    local function ChanceGetVelocity(Root)
        local Now = tick()
        local Data = ChanceMotion[Root]
        local Pos = Root.Position
        if not Data then
            ChanceMotion[Root] = { LastPos = Pos, LastTime = Now, Velocity = Vector3.zero }
            return Vector3.zero
        end
        local Dt = Now - Data.LastTime
        if Dt <= 0 then return Data.Velocity end
        Data.Velocity = (Pos - Data.LastPos) / Dt
        Data.LastPos = Pos
        Data.LastTime = Now
        return Data.Velocity
    end

    local function ChancePredict(Root)
        local Vel = ChanceGetVelocity(Root)
        local Pos = Root.Position
        local Speed = Vel.Magnitude
        if State.ChanceAntiBait and Speed > 30 then
            Vel = Vel.Unit * 30
            Speed = 30
        end
        local Value = tonumber(State.ChancePredValue) or 0.5
        local Mode = State.ChancePredMode or "Velocity"
        if Mode == "Look" then return Pos + Root.CFrame.LookVector * (Speed * Value) end
        if Mode == "LookPing" then return Pos + Root.CFrame.LookVector * (Speed * ChanceGetPing()) end
        if Speed < 0.5 then return Pos end
        local Lead = Value
        if Mode == "Ping" then Lead = ChanceGetPing() * Value end
        return Pos + Vel * Lead
    end

    local function ChanceNearest()
        if not KillersFolder or not LocalRoot then return nil end
        local Best, BestDist = nil, math.huge
        for _, Killer in KillersFolder:GetChildren() do
            local Root = Killer:FindFirstChild("HumanoidRootPart")
            local Hum = Killer:FindFirstChildOfClass("Humanoid")
            if Root and Hum and Hum.Health > 0 then
                local Dist = (Root.Position - LocalRoot.Position).Magnitude
                if Dist < BestDist then
                    BestDist = Dist
                    Best = Root
                end
            end
        end
        return Best
    end

    local function ChanceStopGyro()
        if ChanceGyro then
            ChanceGyro:Destroy()
            ChanceGyro = nil
        end
    end

    RunService.RenderStepped:Connect(function()
        if not State.ChanceAim or not LocalRoot or not LocalRoot.Parent then
            ChanceStopGyro()
            return
        end
        local Active
        if State.ChanceHoldToAim then
            Active = ChanceHolding
        else
            Active = os.clock() < ChanceAimingUntil
        end
        if not Active then
            ChanceStopGyro()
            return
        end
        local Target = ChanceNearest()
        if not Target then return end
        local Pos = ChancePredict(Target)
        local AimPos = State.ChanceHeightAim and Pos or Vector3.new(Pos.X, LocalRoot.Position.Y, Pos.Z)
        if not ChanceGyro or not ChanceGyro.Parent then
            ChanceGyro = Instance.new("BodyGyro")
