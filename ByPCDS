local function StopPlusAnimation()
    if PlusAnimState.MoveConnection then PlusAnimState.MoveConnection:Disconnect(); PlusAnimState.MoveConnection = nil end
    for _, track in PlusAnimState.CurrentTracks do pcall(function() track:Stop() end) end
    PlusAnimState.CurrentTracks = {}
