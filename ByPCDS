local function ScanKillerM1()
    local Assets = ReplicatedStorage:FindFirstChild("Assets")
    if not Assets then return end
    local Roots = {}
    local KillerAssets = Assets:FindFirstChild("Killers")
    if KillerAssets then table.insert(Roots, KillerAssets) end
    local Skins = Assets:FindFirstChild("Skins")
    local KillerSkins = Skins and Skins:FindFirstChild("Killers")
    if KillerSkins then table.insert(Roots, KillerSkins) end
    local Count = 0
    for _, Root in Roots do
        for _, Module in Root:GetDescendants() do
            if Module:IsA("ModuleScript") and Module.Name == "Config" and not Module.Parent:IsA("Model") then
                local Ok, Data = CachedRequire(Module)
                local Animations = Ok and type(Data) == "table" and Data.Animations
                if type(Animations) == "table" then
                    for Key, Value in Animations do
                        local Kind = M1KeyOf(Key)
                        if Kind then CollectM1Ids(Value, Kind, 0) end
                    end
                end
                Count += 1
                if Count % 20 == 0 then task.wait() end
            end
        end
    end
end

