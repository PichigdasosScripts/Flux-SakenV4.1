local function WatchKiller(Killer)
    if WatchConns[Killer] or not Killer:IsA("Model") then return end
    local List = {}
    WatchConns[Killer] = List
    local Humanoid = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid", 5)
    local Animator = Humanoid and (Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 3))
    if Animator then
        table.insert(List, Animator.AnimationPlayed:Connect(function(Track)
            if not State.AutoBlock or not Track.Animation then return end
            local Id = IdOf(Track.Animation.AnimationId)
            if Id and M1Animations[Id] then HandleAttack(Killer) end
        end))
    end
    local function Hook(Descendant)
        if not Descendant:IsA("Sound") or HookedSounds[Descendant] then return end
        HookedSounds[Descendant] = true
        table.insert(List, Descendant.Played:Connect(function()
            if not State.AutoBlock then return end
            local Id = IdOf(Descendant.SoundId)
            if Id and M1Sounds[Id] then HandleAttack(Killer) end
        end))
    end
    table.insert(List, Killer.DescendantAdded:Connect(Hook))
    for _, Descendant in ipairs(Killer:GetDescendants()) do Hook(Descendant) end
    table.insert(List, Killer.AncestryChanged:Connect(function(_, Parent)
        if Parent == nil then
            for _, C in ipairs(List) do C:Disconnect() end
            WatchConns[Killer] = nil
        end
    end))
end

