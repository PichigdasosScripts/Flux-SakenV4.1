        end)
    end
    if LocalCharacter then task.spawn(ChanceHookAnimator, LocalCharacter) end
    LocalPlayer.CharacterAdded:Connect(function(Character) task.spawn(ChanceHookAnimator, Character) end)

    local ElliotHum, ElliotHRP
    local ElliotThrowing, ElliotThrowTS = false, 0
    local ElliotAutoRotate
    local ElliotThrowAnimId = "114155003741146"

    local function ElliotSetup(Character)
        ElliotHum = Character:WaitForChild("Humanoid", 5)
        ElliotHRP = Character:WaitForChild("HumanoidRootPart", 5)
        local Animator = ElliotHum and ElliotHum:FindFirstChildOfClass("Animator")
        if not Animator then return end
        Animator.AnimationPlayed:Connect(function(Track)
            local Id = Track.Animation and Track.Animation.AnimationId or ""
            if Id:find(ElliotThrowAnimId) then
                ElliotThrowing = true
                ElliotThrowTS = tick()
            end
        end)
    end
    if LocalCharacter then task.spawn(ElliotSetup, LocalCharacter) end
    LocalPlayer.CharacterAdded:Connect(function(Character) task.spawn(ElliotSetup, Character) end)

    local function ElliotRestore()
        if ElliotAutoRotate ~= nil and ElliotHum then
            ElliotHum.AutoRotate = ElliotAutoRotate
        end
        ElliotAutoRotate = nil
    end

    local function ElliotFindTarget()
        local Survivors = SurvivorsFolder
        if not Survivors or not ElliotHRP then return nil end
        local Best, BestVal = nil, math.huge
        for _, Survivor in Survivors:GetChildren() do
            if Survivor ~= LocalCharacter then
                local Hum = Survivor:FindFirstChildOfClass("Humanoid")
                local Root = Survivor:FindFirstChild("HumanoidRootPart")
                if Hum and Root and Hum.Health > 0 then
                    local Val = Hum.Health
                    if State.ElliotTargetMode == "Closest" then
                        Val = (Root.Position - ElliotHRP.Position).Magnitude
                    end
                    if Val < BestVal then
                        Best = Root
                        BestVal = Val
                    end
                end
            end
        end
        return Best
    end

    local function ElliotAim(Target)
        local AimType = State.ElliotAimType or "Camera + Character"
        local Force = tonumber(State.ElliotForce) or 80
        local Smooth = tonumber(State.ElliotSmooth) or 0.15
        local Pred = tonumber(State.ElliotPred) or 5
        local Dist = (Target.Position - ElliotHRP.Position).Magnitude
        local PredTime = math.min(Dist / Force, 1.0)
        local PredPos = Target.Position + Target.AssemblyLinearVelocity * PredTime * (Pred / 5)
        local UseHRP = AimType == "HRP Aimbot" or AimType == "Camera + Character"
        local UseCam = AimType == "Camera Aimbot" or AimType == "Camera + Character"

        if UseHRP then
            local Flat = Vector3.new(PredPos.X - ElliotHRP.Position.X, 0, PredPos.Z - ElliotHRP.Position.Z)
            if Flat.Magnitude > 0.01 then
                if ElliotAutoRotate == nil then
                    ElliotAutoRotate = ElliotHum.AutoRotate
                    ElliotHum.AutoRotate = false
                end
                ElliotHRP.AssemblyAngularVelocity = Vector3.zero
                local LookAt = CFrame.lookAt(ElliotHRP.Position, ElliotHRP.Position + Flat.Unit)
                local Cur = ElliotHRP.CFrame
                ElliotHRP.CFrame = Cur:Lerp(CFrame.new(Cur.Position) * LookAt.Rotation, Smooth)
            end
        end
        if UseCam then
            local Cam = workspace.CurrentCamera
            if Cam then
                Cam.CFrame = Cam.CFrame:Lerp(CFrame.lookAt(Cam.CFrame.Position, PredPos), Smooth * 1.5)
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        if not State.ElliotAim or not ElliotHum or not ElliotHRP then
            ElliotRestore()
            return
        end
        if State.ElliotRequireAnim then
            if ElliotThrowing and tick() - ElliotThrowTS > (tonumber(State.ElliotThrowWindow) or 0.6) then
                ElliotThrowing = false
            end
            if not ElliotThrowing then
                ElliotRestore()
                return
            end
        end
        local Target = ElliotFindTarget()
        if not Target then
            ElliotRestore()
            return
        end
        ElliotAim(Target)
    end)
end

