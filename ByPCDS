local function FlatOffset(From, To)
    local Offset = To - From
    return Vector3.new(Offset.X, 0, Offset.Z)
end

local function FlatLook(Root)
    local Look = Root.CFrame.LookVector
    return Vector3.new(Look.X, 0, Look.Z)
end

local function GetHitboxCF(KillerRoot, Killer)
    local Range = State.BlockRange or 15
    return KillerRoot.CFrame * CFrame.new(0, 0, -Range / 2), Vector3.new(6, 6, Range)
end

local function InZone(Killer, KillerRoot, MyRoot)
    if State.BlockMethod == "Cone" then
        local Flat = FlatOffset(KillerRoot.Position, MyRoot.Position)
        local Distance = Flat.Magnitude
        if Distance > (State.ConeLength or ConeReach) then return false end
        if Distance < 0.01 then return true end
        local Look = FlatLook(KillerRoot)
        if Look.Magnitude < 0.01 then return true end
        local Half = math.rad((State.ConeWidth or 10) / 2)
        return Look.Unit:Dot(Flat.Unit) >= math.cos(Half)
    end
    local Range = State.BlockRange or 15
    local Offset = MyRoot.Position - KillerRoot.Position
    local Magnitude = Offset.Magnitude
    if Magnitude <= 0 or Magnitude > Range then return false end
    return KillerRoot.CFrame.LookVector:Dot(Offset.Unit) >= 0.3
end

local function ZoneAllows(Killer, KillerRoot, MyRoot)
    if InZone(Killer, KillerRoot, MyRoot) then return true end
    if State.StrictInHitbox then
        return FlatOffset(KillerRoot.Position, MyRoot.Position).Magnitude <= NearGuarantee
    end
    return true
end

local function WallBlocked(KillerRoot, MyRoot)
    local Filter = {}
    if LocalCharacter then table.insert(Filter, LocalCharacter) end
    if PlayersFolder then table.insert(Filter, PlayersFolder) end
    local Ragdolls = workspace:FindFirstChild("Ragdolls")
    if Ragdolls then table.insert(Filter, Ragdolls) end
    WallParams.FilterDescendantsInstances = Filter
    local Origin = KillerRoot.Position
    local Hit = workspace:Raycast(Origin, MyRoot.Position - Origin, WallParams)
    return Hit ~= nil and Hit.Instance.CanCollide
end

local function PassesChecks(KillerRoot, MyRoot)
    local Flat = FlatOffset(KillerRoot.Position, MyRoot.Position)
    local Look = FlatLook(KillerRoot)
    if Flat.Magnitude > 0.01 and Look.Magnitude > 0.01 then
        local Facing = Look.Unit:Dot(Flat.Unit)
        if State.FacingCheck and Facing < -0.3 then return false end
        if State.VisualCheck and Facing < 0.35 then return false end
    end
    if State.WallCheck and WallBlocked(KillerRoot, MyRoot) then return false end
    return true
end

