do
    local Flip = { Height = 72, Distance = 35, Busy = false, Holder = nil, Connection = nil, Bar = nil, BarWidth = nil }
    local FLIP_STATES = {
        Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Running,
        Enum.HumanoidStateType.Seated,
        Enum.HumanoidStateType.Climbing,
    }

    local function SetFlipStates(Humanoid, Enabled)
        for _, StateType in ipairs(FLIP_STATES) do
            Humanoid:SetStateEnabled(StateType, Enabled)
        end
    end

    local function DoFrontFlip()
        if Flip.Busy then return end
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not (Root and Humanoid) or Humanoid.Health <= 0 then return end
        Flip.Busy = true
        local Tracks = {}
        local Animator = Humanoid:FindFirstChildOfClass("Animator")
        if Animator then
            for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
                table.insert(Tracks, { Track = Track, Time = Track.TimePosition })
                Track:Stop(0)
            end
        end
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        SetFlipStates(Humanoid, false)
        local Steps, Duration = 120, 0.45
        local StartCF = Root.CFrame
        local Forward = StartCF.LookVector
        local Up = Vector3.new(0, 1, 0)
        local Height, Distance = Flip.Height, Flip.Distance
        task.spawn(function()
            pcall(function()
                local StartedAt = os.clock()
                for Step = 1, Steps do
                    local T = Step / Steps
                    local Lift = Height * (T - T * T)
                    local Position = StartCF.Position + Forward * (Distance * T) + Up * Lift
                    local Spin = StartCF.Rotation * CFrame.Angles(-math.rad(Step * (360 / Steps)), 0, 0)
                    if Root.Parent then
                        Root.CFrame = CFrame.new(Position) * Spin
                    end
                    local Wait = (Duration / Steps) * Step - (os.clock() - StartedAt)
                    if Wait > 0 then task.wait(Wait) end
                end
                if Root.Parent then
                    Root.CFrame = CFrame.new(StartCF.Position + Forward * Distance) * StartCF.Rotation
                end
            end)
            if Humanoid.Parent then
                pcall(SetFlipStates, Humanoid, true)
                pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
            end
            for _, Entry in ipairs(Tracks) do
                pcall(function()
                    Entry.Track:Play()
                    Entry.Track.TimePosition = Entry.Time
                end)
            end
            task.wait(0.25)
            Flip.Busy = false
        end)
    end

