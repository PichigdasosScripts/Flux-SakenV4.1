local SprintingModule
local SprintingHooked = false
local SprintingRetryAt = 0

local function GetSprinting()
    if SprintingModule then return SprintingModule end
    if os.clock() < SprintingRetryAt then return nil end
    SprintingRetryAt = os.clock() + 5
    local Success, Module = pcall(function()
        return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
    end)
    if Success and type(Module) == "table" then SprintingModule = Module end
    return SprintingModule
end

local InfStamThread

local function InfStaminaApply()
    local Sprinting = GetSprinting()
    if not Sprinting then return end
    Sprinting.StaminaLossDisabled = true
    local Max = Sprinting.MaxStamina
    if type(Max) == "number" and type(Sprinting.Stamina) == "number" and Sprinting.Stamina < Max then
        Sprinting.Stamina = Max
    end
end

local function SetInfiniteStamina(Enabled)
    SprintingRetryAt = 0
    local Sprinting = GetSprinting()
    if not Sprinting then Notify("Infinite Stamina", "Could not find the sprinting module", 4); return end
    if not SprintingHooked and typeof(Sprinting.Init) == "function" then
        SprintingHooked = true
        local OldInit = Sprinting.Init
        Sprinting.Init = function(...)
            local Result = OldInit(...)
            if State.InfiniteStamina then InfStaminaApply() end
            return Result
        end
    end
    if Enabled then
        InfStaminaApply()
        if not InfStamThread then
            InfStamThread = task.spawn(function()
                while State.InfiniteStamina do
                    pcall(InfStaminaApply)
                    task.wait(0.2)
                end
                InfStamThread = nil
            end)
        end
    else
        Sprinting.StaminaLossDisabled = false
    end
end

