    local GearFarm = { On = false, Thread = nil, Hold = 1.5 }

    local function FindGears()
        local Found = {}
        local Map = workspace:FindFirstChild("Map")
        local Ingame = Map and Map:FindFirstChild("Ingame")
        if not Ingame then return Found end
        for _, Object in ipairs(Ingame:GetDescendants()) do
            if Object.Name == "Gear" and (Object:IsA("Model") or Object:IsA("Tool") or Object:IsA("BasePart")) then
                local Parent = Object.Parent
                if not (Parent and Parent:IsA("Model") and Parent:FindFirstChildOfClass("Humanoid")) then
                    table.insert(Found, Object)
                end
            end
        end
        return Found
    end

    local function GearPart(Gear)
        if Gear:IsA("BasePart") then return Gear end
        return Gear.PrimaryPart or Gear:FindFirstChildWhichIsA("BasePart", true)
    end

    local function GrabGear(Gear, Part, Root)
        for _, Prompt in ipairs(Gear:GetDescendants()) do
            if Prompt:IsA("ProximityPrompt") and Prompt.Enabled then
                pcall(function()
                    if typeof(fireproximityprompt) == "function" then
                        fireproximityprompt(Prompt)
                    else
                        Prompt:InputHoldBegin()
                        Prompt:InputHoldEnd()
                    end
                end)
            end
        end
        if typeof(firetouchinterest) == "function" and Root and Part then
            pcall(firetouchinterest, Root, Part, 0)
            pcall(firetouchinterest, Root, Part, 1)
        end
    end

    local function CollectGear(Gear)
        local Part = GearPart(Gear)
        if not Part then return end
        local StartedAt = os.clock()
        while GearFarm.On and Gear.Parent and os.clock() - StartedAt < GearFarm.Hold do
            local Character = LocalPlayer.Character
            local Root = Character and Character:FindFirstChild("HumanoidRootPart")
            if not Root or not Part.Parent then break end
            Root.CFrame = Part.CFrame * CFrame.new(0, 3, 0)
            Root.AssemblyLinearVelocity = Vector3.zero
            GrabGear(Gear, Part, Root)
            task.wait(0.1)
        end
    end

    local function GearFarmLoop()
        while GearFarm.On do
            for _, Gear in ipairs(FindGears()) do
                if not GearFarm.On then break end
                if Gear.Parent then CollectGear(Gear) end
                task.wait(0.2)
            end
            task.wait(0.5)
        end
        GearFarm.Thread = nil
    end

    AddSection(Tabs.Misc, "Gear Auto Farm")
    AddToggle(Tabs.Misc, "GearAutoFarm", "Gear Auto Farm", false, function(Value)
        GearFarm.On = Value
        if Value and not GearFarm.Thread then
            GearFarm.Thread = task.spawn(GearFarmLoop)
        end
    end)
    AddSlider(Tabs.Misc, "GearHoldTime", "Hold Time (s)", 0.5, 5, 1.5, 0.1, function(Value)
        GearFarm.Hold = Value
    end)
